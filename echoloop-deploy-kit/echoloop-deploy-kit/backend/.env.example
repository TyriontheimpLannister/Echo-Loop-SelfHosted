# ===== LLM（翻译 / 解析 / 意群 / 词典）=====
# 默认 DeepSeek，国内直连、便宜。可换成通义、智谱、OpenAI 等 OpenAI 兼容端点。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# 默认翻译/解析目标语言（客户端也会单独传，以客户端为准）
TARGET_LANGUAGE=zh-CN

# ===== 转录引擎 =====
# openai : 调用 OpenAI 兼容 Whisper API（需下面的 OPENAI_API_KEY），质量好、省心
# local  : 本地 faster-whisper（免费，但需 CPU 支持 AVX2；J4125 无 AVX2，不可用）
TRANSCRIBE_ENGINE=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 转录模型名：OpenAI 用 whisper-1；Groq 等兼容端点用 whisper-large-v3 等
TRANSCRIBE_MODEL=whisper-1

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=./uploads
